# Runtime
ENV=dev
LOG_LEVEL=INFO

# Models / Keys (placeholder bırak!)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=__PUT_YOUR_KEY_HERE__

TAVILY_API_KEY=__OPTIONAL__

# DB
DB_URL=sqlite:///app/data/thy_ops.db

# Redis / RediSearch
REDIS_URL=redis://localhost:6379
REDIS_INDEX=sql_cache
REDIS_PREFIX=doc:

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBED_DIM=3072

# Retriever
HYBRID_W_VEC=0.6
HYBRID_W_BM25=0.4
RETRIEVER_SEED_JSONL=./app/data/approved_seeds.jsonl
RETRIEVER_TAG_FILTER=approved|seed

# RAG kaynakları
POLICY_CSV=app/data/thy_qa_policy.csv
POLICY_PDFS=app/data/yolcu_haklari.pdf,app/data/yolcu_bagaj_tasima_genel_sartlar.pdf,app/data/Online_kanallar_kullanim_sartlari.pdf
POLICY_INDEX_DIR=app/data/thy_policy_index

# Cache
CACHE_SCORE_THRESHOLD=0.85
CACHE_EXECUTE_SQL_ON_HIT=true
CACHE_REQUIRE_APPROVAL=true
CACHE_ALLOWED_TAGS=approved,seed
CACHE_LLM_ON_HIT=false

# SQL guards
SQL_DEFAULT_LIMIT=200
TIME_WINDOW_DAYS_DEFAULT=30

# Feature flags
USE_PARALLEL_GRAPH=true
USE_LANGCHAIN_RETRIEVER=true
ENABLE_NL2SQL=false
